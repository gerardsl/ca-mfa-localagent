# Copy to .env (Copy-Item .env.example .env) and fill in your own values. Never commit .env.

# Mistral (LLM): your own API key from https://console.mistral.ai
MODEL_PROVIDER=mistral
MISTRAL_API_KEY=<your-mistral-api-key>
MISTRAL_MODEL=ministral-3b-2512

# Optional: names of the objects created in your tenant (defaults shown)
# BLUEPRINT_NAME=Spain-News-Agent-Blueprint
# AGENT_IDENTITY_NAME=Spain-News-Agent-Identity
# CLIENT_APP_NAME=Spain-News-Agent-Client
# CA_POLICY_NAME=Spain-News-Agent-CA

# Microsoft Entra Agent ID: leave these empty. setup/admin_login.py saves your tenant ID and
# setup/provision_entra.py fills in the rest after creating the objects in your tenant.
AZURE_TENANT_ID=
AGENT_CLIENT_APP_ID=
BLUEPRINT_APP_ID=
BLUEPRINT_CLIENT_SECRET=
AGENT_IDENTITY_APP_ID=
AGENT_SCOPE=

# Optional: web UI port (default 5050)
# WEB_PORT=5050
